# Copy to .env and adjust. .env is git-ignored; never commit real credentials.
# Every variable is optional: the defaults below are what the server already uses.

# --- Identity ---------------------------------------------------------------
GTM_SERVER_NAME=gtm-mcp-server
GTM_ENVIRONMENT=local            # local | test | production

# --- Transport --------------------------------------------------------------
GTM_TRANSPORT=stdio              # stdio (local MCP clients) | streamable-http (remote)
GTM_HTTP_HOST=127.0.0.1
GTM_HTTP_PORT=8000

# --- Logging ----------------------------------------------------------------
# Logs always go to stderr; stdout is reserved for the JSON-RPC stream.
GTM_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
GTM_LOG_FORMAT=json              # json | console

# --- Mock CRM database ------------------------------------------------------
GTM_DATABASE_URL=postgresql+asyncpg://gtm:gtm@localhost:5432/gtm
GTM_DB_POOL_SIZE=5
GTM_DB_CONNECT_TIMEOUT_SECONDS=5.0

# --- Write guardrails -------------------------------------------------------
GTM_ENABLE_WRITE_TOOLS=true      # false => write tools refuse every call
GTM_DRY_RUN_WRITES=false         # true  => validate and audit, never persist
GTM_MAX_WRITE_BATCH_SIZE=1

# --- External enrichment ----------------------------------------------------
# 'sample' answers from the offline synthetic dataset in this repository and needs
# no credential; every result reports provenance.live = false.
# 'hunter' calls the live Hunter API and REQUIRES GTM_ENRICHMENT_API_KEY - selecting
# it without one fails at startup rather than quietly serving sample data.
# See DECISIONS.md D-017 for why Hunter, and for free-tier limits.
GTM_ENRICHMENT_PROVIDER=sample   # sample | hunter

# Get a key at https://hunter.io (free plan includes API access, 50 credits/month).
# Sent as an X-API-KEY header, never as a query parameter. Never commit a real key.
# GTM_ENRICHMENT_API_KEY=

GTM_ENRICHMENT_TIMEOUT_SECONDS=15.0        # kept above the provider's own search duration
GTM_ENRICHMENT_MAX_RETRIES=2               # extra attempts on 5xx/timeout only, never on a rejection
GTM_ENRICHMENT_RETRY_BACKOFF_SECONDS=0.5   # attempt n waits backoff * 2^(n-1)
