{
  "mcpServers": {
    "gtm": {
      "command": "uv",
      "args": [
        "--directory",
        "C:/absolute/path/to/GTM_MCP_PROJ",
        "run",
        "gtm-mcp-server"
      ],
      "env": {
        "GTM_ENABLE_WRITE_TOOLS": "false",
        "GTM_ENRICHMENT_PROVIDER": "sample",
        "GTM_LOG_LEVEL": "INFO"
      }
    }
  }
}
